<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds support user-configured HTTP backends on the local LAN. -->
    <base-config cleartextTrafficPermitted="true">
        <!-- Trust user-installed CAs for self-hosted servers with self-signed certificates. -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
